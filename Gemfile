source 'https://rubygems.org'

# Framework de escenarios Gherkin.
gem 'cucumber'

# Aserciones RSpec (expect) registradas en el World de Cucumber.
gem 'rspec-expectations'

# Plataforma detectada en los insumos (FIRETV / ADTV / FTV) => Android.
# Driver móvil Appium con automationName UiAutomator2.
# appium_lib incluye selenium-webdriver como dependencia (usado solo para las
# esperas explícitas), pero NO se usa Selenium como driver principal.
gem 'appium_lib'
